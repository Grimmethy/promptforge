.venv/
__pycache__/
*.pyc
gallery/*
!gallery/.gitkeep
# one-hour hand-offs from the library forges (a picture to tweak, an empty slot to fill)
handoff/
# pictures the owner saved to the Library (a copy, kept apart from the gallery that is swept)
library/
# the sweep's switch (the owner creates it) and its log
data/sweep-enabled
data/sweep.log
.env
# explicit-content overlay merged in only while the NSFW toggle is on
data/nsfw/
# internal log of clean image copies (names the source, never prompt text)
data/clean-exports.jsonl

# Agent Manager pipeline runtime data: written into the active project's repo, not source.
graphify-out/
task-logs/
# the slot-fill engine's run reports and contact sheets (generated, kept out of git)
data/slot-fill-runs/
